template <typename T>
Array<T>::Array()
{
	_values = new T[0]();
	_size = 0;
}

template <typename T>
Array<T>::Array(unsigned int n)
{
	_values = new T[n]();
	_size = n;
}

template <typename T>
Array<T>::~Array()
{
	delete []_values;
}

template <typename T>
Array<T>& Array<T>::operator=(const Array& anArray)
{
	if (this == &anArray)
		return (*this);
	delete []_values; 
	unsigned int	i = 0;
	_values = new T[anArray._size]();
	while (i < anArray._size)
	{
		_values[i] = anArray._values[i];
		++i;
	}
	_size = anArray._size;
	return (*this);
}

template <typename T>
Array<T>::Array(const Array& anArray)
{
	unsigned int	i = 0;
	_values = new T[anArray._size]();
	while (i < anArray._size)
	{
		_values[i] = anArray[i];
		++i;
	}
	_size = anArray._size;
}

template <typename T>
unsigned int	Array<T>::size()
{
	return (_size);
}

template <typename T>
T& Array<T>::operator[](unsigned int index)
{
	if (index >= _size)
		throw std::exception();
	return (_values[index]);
}

template <typename T>
const T& Array<T>::operator[](unsigned int index) const
{
	if (index >= _size)
		throw std::exception();
	return (_values[index]);
}
