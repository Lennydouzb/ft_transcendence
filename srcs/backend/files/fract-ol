#include "../../header/fractol.h"

static void	draw_line(t_mlx_data *data, int y,
				t_complex scale, unsigned int *pix)
{
	int		x;
	int		i;
	double	zr;
	double	zi;
	double	step;

	x = 0;
	step = scale.r;
	zi = (y - ((HEIGHT) / 2.0)) * scale.i + data->view.center_i;
	zr = (-WIDTH / 2.0) * step + data->view.center_r;
	while (x < WIDTH)
	{
		if (data->fractal_type == 1)
			i = julia(zr, zi, data->c.r, data->c.i);
		else if (data->fractal_type == 0)
			i = mandelbrot(zr, zi, 50 + log(data->view.zoom) * 20);
		else if (data->fractal_type == 2)
			i = burning(zr, zi, 100);
		pix[x] = data->cur_palette[i];
		zr += step;
		x++;
	}
}

void	draw(t_mlx_data *data)
{
	int				y;
	t_complex		scale;
	unsigned int	*pix;

	scale.r = 1.0 / (0.5 * data->view.zoom * WIDTH);
	scale.i = 1.0 / (0.5 * data->view.zoom * HEIGHT);
	y = 0;
	while (y < HEIGHT)
	{
		pix = (unsigned int *)(data->img.img_pixels_ptr
				+ y * data->img.line_len);
		draw_line(data, y, scale, pix);
		y++;
	}
	mlx_put_image_to_window(data->mlx_ptr, data->win_ptr,
		data->img.img_ptr, 0, 0);
}
