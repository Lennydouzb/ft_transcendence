#include "../include/pipex.h"

void	free2d(char **arr)
{
	int	i;

	i = 0;
	while (arr[i])
	{
		free(arr[i]);
		i++;
	}
	free(arr);
}

static void	execute(char *cmd, char **env)
{
	char	**split_cmd;
	char	*path;

	split_cmd = ft_split(cmd, ' ');
	path = get_cmd(split_cmd[0], env);
	if (!path)
	{
		print_error("command not found : ", split_cmd[0]);
		free(path);
		free2d(split_cmd);
		return ;
	}
	if (execv(path, split_cmd) == -1)
	{
		print_error("an error occured try again", NULL);
		free(path);
		free2d(split_cmd);
		return ;
	}
}

static void	parent(int *pfd, char *out, char *cmd, char **env)
{
	int	fd;

	fd = open(out, O_CREAT | O_WRONLY | O_TRUNC, 0644);
	if (fd == -1)
	{
		close(pfd[1]);
		close(pfd[0]);
		print_error("cannot create or open the following file", out);
		return ;
	}
	if (access(out, W_OK) == -1)
	{
		close(pfd[1]);
		close(pfd[0]);
		print_error("cannot write in the following file", out);
		close(fd);
		return ;
	}
	dup2(fd, 1);
	dup2(pfd[0], 0);
	close(fd);
	close(pfd[0]);
	close(pfd[1]);
	execute(cmd, env);
}

static void	child(int *pfd, char *in, char *cmd, char **env)
{
	int	fd;

	if (access(in, F_OK | R_OK) == -1)
	{
		close(pfd[1]);
		close(pfd[0]);
		print_error("cannot read the following file : ", in);
		return ;
	}
	fd = open(in, O_RDONLY);
	if (fd == -1)
	{
		close(pfd[1]);
		close(pfd[0]);
		print_error("no such file or directory : ", in);
		return ;
	}
	dup2(fd, 0);
	dup2(pfd[1], 1);
	close(fd);
	close(pfd[1]);
	close(pfd[0]);
	execute(cmd, env);
}

int	main(int ac, char **av, char **env)
{
	int		fd[2];
	pid_t	process;

	if (ac != 5)
	{
		print_error("program must be used as such :", \
"./pipex infile cmd1 cmd2 outfile");
		return (1);
	}
	if (av[2][0] == '\0' || av[3][0] == '\0')
		return (1);
	if (pipe(fd) == -1)
		return (1);
	process = fork();
	if (process == 0)
	{
		child(fd, av[1], av[2], env);
		return (1);
	}
	waitpid(process, NULL, 0);
	parent(fd, av[4], av[3], env);
	return (1);
}
